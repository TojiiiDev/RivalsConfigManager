# ------------------------------------------------------------------------- #
# Rivals Config Manager — environment configuration (example).
#
# Copy this file to `.env` (NOT committed) and fill in real values. The
# application reads these through os.environ; none of them are required for
# the app to run locally or offline.
# ------------------------------------------------------------------------- #

# Base URL of the asset repository. Assets and the manifest are fetched from:
#   <RCM_ASSET_BASE_URL>/manifest.json
#   <RCM_ASSET_BASE_URL>/assets/<relative path from the manifest>
#
# This must be a trusted HTTPS host (the sync layer only accepts HTTPS URLs
# rooted at this base). When unset, the app uses the built-in default:
#   https://raw.githubusercontent.com/TojiiiDev/RivalsConfigManager/main
# Set it to override (mirror / self-hosting), or to an EMPTY value to disable
# the remote entirely (offline / tests).
# RCM_ASSET_BASE_URL=https://raw.githubusercontent.com/TojiiiDev/RivalsConfigManager/main

# Optional: maximum asset download size in bytes (default 10 MB per file).
# RCM_ASSET_MAX_BYTES=10485760

# Optional: network timeout in seconds for manifest/asset requests (default 15).
# RCM_ASSET_TIMEOUT=15

# Enable the admin toolset (asset sync + Editor Mode) without rebuilding.
# This is a lightweight guard to stop a normal user from editing official
# resources — NOT an authentication system. Set to "1" to activate, or leave
# unset (default) for a normal user build.
# RCM_ADMIN_MODE=1
